{
 "name": "milo.",
 "short_name": "milo.",
 "description": "My Music, My Way. A music player with adaptive backgrounds, synced lyrics and live radio.",
 "id": "./",
 "start_url": "./index.html",
 "scope": "./",
 "display": "standalone",
 "orientation": "any",
 "background_color": "#2d2f2e",
 "theme_color": "#0a0a0b",
 "categories": [
  "music",
  "entertainment"
 ],
 "icons": [
  {
   "src": "icons/icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icons/maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "icons/icon.svg",
   "sizes": "any",
   "type": "image/svg+xml",
   "purpose": "any"
  }
 ],
 "shortcuts": [
  {
   "name": "Search",
   "url": "./index.html#search",
   "icons": [
    {
     "src": "icons/icon-192.png",
     "sizes": "192x192"
    }
   ]
  },
  {
   "name": "Discover",
   "url": "./index.html#discover",
   "icons": [
    {
     "src": "icons/icon-192.png",
     "sizes": "192x192"
    }
   ]
  },
  {
   "name": "Library",
   "url": "./index.html#library",
   "icons": [
    {
     "src": "icons/icon-192.png",
     "sizes": "192x192"
    }
   ]
  }
 ],
 "file_handlers": [
  {
   "action": "./index.html",
   "accept": {
    "audio/*": [
     ".mp3",
     ".m4a",
     ".aac",
     ".flac",
     ".wav",
     ".ogg",
     ".opus"
    ]
   }
  }
 ],
 "launch_handler": {
  "client_mode": "navigate-existing"
 }
}