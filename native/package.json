{
  "name": "milo-native",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor Android wrapper for milo.",
  "scripts": {
    "prepare:web": "node scripts/prepare.mjs",
    "android:add": "npx cap add android && node scripts/patch-android.mjs",
    "sync": "npm run prepare:web && npx cap sync android && node scripts/patch-android.mjs",
    "assets": "npx capacitor-assets generate --android --assetPath resources",
    "build:debug": "cd android && ./gradlew assembleDebug",
    "build:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@anuradev/capacitor-background-mode": "^8.1.0",
    "@capacitor-community/keep-awake": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0"
  }
}
